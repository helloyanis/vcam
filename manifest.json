{
    "manifest_version": 3,
    "name": "vCam Virtual Camera",
    "version": "1.3.1",
    "description": "Record a screen or tab as a virtual camera for sites to see!",
    "author": "🦊 helloyanis",
    "developer": {
        "name": "🦊 helloyanis",
        "url": "https://🦊💻️.ws"
    },
    "browser_specific_settings": {
        "gecko": {
          "id": "helloyanis@vcam",
            "data_collection_permissions": {
                "required": ["none"]
            },
            "strict_min_version": "140.0"
        },
        "gecko_android":{
            "strict_min_version": "142.0"
        }
    },
    "permissions": [
        "scripting",
        "storage"
    ],
    "optional_permissions": [
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["cameraContentScript.js"],
            "all_frames": true,
            "run_at": "document_start",
            "world": "ISOLATED"
        },
        {
            "matches": ["<all_urls>"],
            "js": ["cameraPage.js"],
            "all_frames": true,
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "background": {
        "scripts": [
            "cameraFeedInjector.js"
        ]
    },
    "action": {
        "default_icon": "icon.svg",
        "default_title": "Configure vcam",
        "default_popup": "popup/index.html"
    }
}